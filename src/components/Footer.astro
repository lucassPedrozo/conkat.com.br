---
import Logo from './Logo.astro';
import { FOOTER, APP_LIVE, DOWNLOAD, STORE_LINKS } from '../lib/content';
const links = FOOTER.links.filter((l) => l.href);
---
{APP_LIVE && (
  <section class="download" aria-labelledby="download-title">
    <div class="container download-inner">
      <div>
        <h2 id="download-title">{DOWNLOAD.title}</h2>
        <p>{DOWNLOAD.text}</p>
      </div>
      <div class="stores">
        <a href={STORE_LINKS.appStore}>App Store</a>
        <a href={STORE_LINKS.googlePlay}>Google Play</a>
      </div>
    </div>
  </section>
)}
<footer class="footer on-dark">
  <div class="container footer-inner">
    <div class="f-brand">
      <a href="#topo" aria-label="Conkat, voltar ao início" class="f-logo"><Logo /></a>
      <span>{FOOTER.region}</span>
    </div>
    {links.length > 0 && (
      <ul class="f-links">{links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
    )}
    <p class="f-legal">{FOOTER.legal}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--text-on-dark-muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block: 2.75rem;
  }
  .f-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .f-logo {
    color: var(--text-on-dark);
    border-radius: 6px;
  }
  .f-logo :global(.logo) {
    height: 1.65rem;
    width: auto;
  }
  .f-links {
    display: flex;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .f-links a:hover {
    color: var(--text-on-dark);
  }
  .download {
    background: var(--primary);
    color: var(--text-on-dark);
  }
  .download-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-block: 5rem;
  }
  .download h2 {
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
  }
  @media (max-width: 760px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
