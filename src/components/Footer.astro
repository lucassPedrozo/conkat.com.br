---
import Logo from './Logo.astro';
import StoreBadges from './StoreBadges.astro';
import Icon from './Icon.astro';
import { FOOTER, APP_LIVE, DOWNLOAD, INSTAGRAM } from '../lib/content';
const links = FOOTER.links.filter((l) => l.href);
---
{APP_LIVE && (
  <section class="download" aria-labelledby="download-title">
    <div class="container download-inner">
      <div>
        <h2 id="download-title">{DOWNLOAD.title}</h2>
        <p>{DOWNLOAD.text}</p>
      </div>
      <StoreBadges />
    </div>
  </section>
)}
<footer class="footer on-dark">
  <div class="container footer-inner">
    <div class="f-brand">
      <a href="#topo" aria-label="Conkat, voltar ao início" class="f-logo"><Logo /></a>
      <span>{FOOTER.region}</span>
    </div>
    <ul class="f-links">
      <li><a class="f-social" href={INSTAGRAM.url} rel="noopener" target="_blank"><Icon name="instagram-logo" size={20} />{INSTAGRAM.handle}</a></li>
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <p class="f-legal">{FOOTER.legal}{FOOTER.cnpj && ` CNPJ ${FOOTER.cnpj}`}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--text-on-dark-muted);
    font-size: 0.9rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block: 2.75rem;
  }
  .f-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .f-logo {
    color: var(--text-on-dark);
    border-radius: 6px;
  }
  .f-logo :global(.logo) {
    height: 1.65rem;
    width: auto;
  }
  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .f-links a:hover {
    color: var(--text-on-dark);
  }
  .f-social {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 6px;
  }
  .download {
    background: var(--primary);
    color: var(--text-on-dark);
  }
  .download-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    padding-block: 5rem;
  }
  .download h2 {
    font-size: var(--step-h1);
    letter-spacing: -0.03em;
  }
  @media (max-width: 760px) {
    .footer-inner {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
