---
// Hero: o texto aparece pronto (quem chega lê na hora). O movimento fica só nos celulares,
// dentro de um painel: entram uma vez, de baixo, e ao rolar se afastam em velocidades
// diferentes, dando profundidade. Dentro do app, os anúncios entram como no app.
import Phone from './app/Phone.astro';
import HomeScreen from './app/HomeScreen.astro';
import DetailScreen from './app/DetailScreen.astro';
import StoreBadges from './StoreBadges.astro';
import Icon from './Icon.astro';
import { HERO, APP_LIVE } from '../lib/content';
---
<section class="hero" id="topo" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title">{HERO.title}</h1>
      <p class="hero-text">{HERO.text}</p>
      <div class="hero-actions">
        {APP_LIVE ? (
          <StoreBadges />
        ) : (
          <>
            <a class="btn btn-primary" href="#profissionais">{HERO.secondary}</a>
            <p class="soon"><Icon name="clock" size={18} />{HERO.soon}</p>
          </>
        )}
      </div>
    </div>
    <div class="hero-panel" aria-hidden="true" data-hero-panel>
      <div class="panel-pattern"></div>
      <div class="phone-slot slot-back" data-depth="0.05">
        <Phone class="phone-back" label=""><DetailScreen eager /></Phone>
      </div>
      <div class="phone-slot slot-front" data-depth="0.11">
        <Phone class="phone-front" label=""><HomeScreen eager /></Phone>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 4.75rem;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    align-items: center;
    gap: clamp(2.5rem, 1rem + 4vw, 5rem);
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) clamp(3rem, 2rem + 3vw, 4.5rem);
  }
  .hero-copy {
    display: grid;
    gap: 1.75rem;
  }
  .hero-title {
    font-size: var(--step-display);
    line-height: 1.04;
    letter-spacing: -0.035em;
    color: var(--ink);
    max-width: 11.5em;
  }
  .hero-text {
    max-width: 33rem;
    font-size: var(--step-lead);
    line-height: 1.6;
    color: var(--text-muted);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 0.25rem;
  }
  .soon {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    font-weight: 500;
  }

  /* Painel com os celulares */
  .hero-panel {
    position: relative;
    height: clamp(30rem, 24rem + 14vw, 37rem);
    border-radius: var(--radius-media);
    background: var(--primary-soft);
    overflow: hidden;
    isolation: isolate;
  }
  .panel-pattern {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('/pattern.svg') 0 0 / 520px auto repeat;
    opacity: 0.45;
  }
  .phone-slot {
    position: absolute;
    will-change: transform;
  }
  .slot-front {
    left: 12%;
    top: 9%;
    z-index: 2;
  }
  .slot-back {
    left: calc(12% + 14.5rem);
    top: 17%;
    z-index: 1;
  }
  .hero-panel :global(.phone-front) {
    --pw: clamp(15.5rem, 12rem + 5vw, 19rem);
    animation: phone-enter 1200ms var(--ease-out) 150ms both;
  }
  .hero-panel :global(.phone-back) {
    --pw: clamp(14rem, 11rem + 4.4vw, 17rem);
    animation: phone-enter 1200ms var(--ease-out) 320ms both;
  }
  @keyframes phone-enter {
    from {
      opacity: 0;
      transform: translateY(48px);
    }
  }
  /* Dentro do app, os anúncios entram como no app: 40 ms entre itens */
  .hero-panel :global(.phone-front .stagger) {
    animation: item-in var(--t-slow) var(--ease-out) both;
    animation-delay: calc(950ms + var(--i) * 40ms);
  }
  @keyframes item-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @media (max-width: 1023px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .hero-panel {
      height: 27rem;
    }
    .slot-front {
      left: calc(50% - 10.5rem);
      top: 2rem;
    }
    .slot-back {
      left: calc(50% + 1.25rem);
      top: 4.5rem;
    }
    .hero-panel :global(.phone-front) {
      --pw: 15.5rem;
    }
    .hero-panel :global(.phone-back) {
      --pw: 13.5rem;
    }
  }
</style>
