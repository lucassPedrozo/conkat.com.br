---
// Selos das lojas (usados quando APP_LIVE = true). Antes de publicar, troque pelos
// selos oficiais da Apple e do Google, que as lojas exigem.
import { STORE_LINKS } from '../lib/content';
---
<div class="stores">
  <a class="store" href={STORE_LINKS.appStore} aria-label="Baixar na App Store">
    <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M16.37 12.73c-.02-2.33 1.9-3.45 1.99-3.5-1.09-1.59-2.78-1.8-3.38-1.83-1.44-.15-2.81.85-3.54.85-.73 0-1.86-.83-3.05-.81-1.57.02-3.02.91-3.83 2.32-1.63 2.83-.42 7.02 1.17 9.32.78 1.12 1.7 2.38 2.91 2.34 1.17-.05 1.61-.76 3.02-.76 1.41 0 1.81.76 3.05.73 1.26-.02 2.06-1.14 2.83-2.27.89-1.3 1.26-2.56 1.28-2.62-.03-.01-2.45-.94-2.45-3.77zM14.04 5.88c.64-.78 1.08-1.86.96-2.94-.93.04-2.05.62-2.72 1.4-.6.69-1.12 1.79-.98 2.85 1.04.08 2.1-.53 2.74-1.31z"/></svg>
    <span><small>Baixar na</small>App Store</span>
  </a>
  <a class="store" href={STORE_LINKS.googlePlay} aria-label="Disponível no Google Play">
    <svg width="20" height="22" viewBox="0 0 22 24" aria-hidden="true"><path fill="#00D7FE" d="M1.1.6C.8.9.6 1.4.6 2v20c0 .6.2 1.1.5 1.4l.1.1L12.4 12.3v-.3L1.2.5z"/><path fill="#FFCE00" d="M16.1 16.1l-3.7-3.8v-.3l3.7-3.8.1.1 4.4 2.5c1.3.7 1.3 1.9 0 2.6l-4.4 2.6z"/><path fill="#FF3A44" d="M16.2 16L12.4 12.2 1.1 23.4c.4.4 1.1.5 1.9.1L16.2 16"/><path fill="#00F076" d="M16.2 8.3L3 .8C2.2.4 1.5.4 1.1.9l11.3 11.3z"/></svg>
    <span><small>Disponível no</small>Google Play</span>
  </a>
</div>

<style>
  .stores {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .store {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.25rem;
    padding: 0 1.1rem 0 0.95rem;
    border-radius: 12px;
    background: #000;
    color: #fff;
    border: 1px solid #3a3a3a;
    transition: transform var(--t-fast) var(--ease-out);
  }
  .store:active {
    transform: scale(var(--press));
  }
  .store span {
    display: grid;
    font-weight: 600;
    font-size: 1.05rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  .store small {
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0;
  }
</style>
