---
// "O que você vê antes de chamar": a tela do anúncio no app, no mesmo celular do resto do
// site, com marcadores numerados. Ao lado, os itens em linhas (como a tabela de condições
// de "Para profissionais"). Enquanto a seção está na tela, os itens se acendem um a um;
// passar o mouse num item (ou na parte do anúncio) fixa o destaque nele.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import Phone from './app/Phone.astro';
import { FEATURES } from '../lib/content';
import encanador from '../assets/photos/encanador.jpg';
---
<section class="features" id="anuncio" aria-labelledby="features-title" data-anatomy>
  <div class="container features-grid">
    <div class="f-head">
      <p class="kicker">{FEATURES.kicker}</p>
      <h2 id="features-title" class="f-title">{FEATURES.title}</h2>
      <p class="f-text">{FEATURES.text}</p>
    </div>

    <div class="f-stage" aria-hidden="true">
      <Phone class="f-phone" label="">
        <div class="ad">
          <Image src={encanador} alt="" widths={[300, 540]} sizes="270px" class="ad-photo" />
          <div class="ad-chips"><span class="ad-chip">Manutenção Residencial</span></div>
          <p class="ad-title">Encanador — reparos e instalações</p>
          <p class="ad-part" data-part="1">
            <span class="ad-price">A partir de R$ 120</span>
            <span class="pin">1</span>
          </p>
          <p class="ad-part" data-part="2">
            <span class="ad-rating"><Icon name="star-fill" size={12} /><strong>4,8</strong><span>· 23 avaliações</span></span>
            <span class="pin">2</span>
          </p>
          <div class="ad-part ad-pro" data-part="3">
            <span class="ad-avatar">RC</span>
            <span class="ad-pro-info">
              <span class="ad-pro-name">Rafael Costa</span>
              <span class="ad-ver"><Icon name="seal-check" size={11} />Verificado</span>
            </span>
            <span class="pin">3</span>
          </div>
          <p class="ad-desc">Vazamentos, troca de registro, desentupimento e instalação de louças. Atendo Joinville e Araquari.</p>
          <span class="ad-wa"><Icon name="whatsapp-logo" size={18} />Chamar no WhatsApp</span>
        </div>
      </Phone>
    </div>

    <div class="f-list">
      <ol class="points" role="list">
        {FEATURES.points.map((p, i) => (
          <li data-point={i + 1}>
            <span class="n" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="review">
        <Icon name="shield-check" size={20} />
        <span><strong>{FEATURES.review.title}.</strong> {FEATURES.review.text}</span>
      </p>
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--section-y);
    background: var(--background);
  }
  /* Desktop: celular à esquerda; título e itens à direita */
  .features-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    grid-template-areas:
      'stage head'
      'stage list';
    grid-template-rows: auto 1fr;
    column-gap: clamp(3rem, 2rem + 5vw, 7rem);
    align-items: start;
  }
  .f-head {
    grid-area: head;
    align-self: end;
  }
  .f-stage {
    grid-area: stage;
    display: grid;
    justify-items: center;
    align-self: center;
  }
  .f-list {
    grid-area: list;
  }

  .kicker {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .f-title {
    margin-top: 1rem;
    font-size: var(--step-h1);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .f-text {
    margin-top: 1.25rem;
    max-width: 32rem;
    font-size: var(--step-lead);
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* Itens: linhas finas, sem cards */
  .points {
    max-width: 36rem;
    margin: 2.25rem 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }
  .points li {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border-strong);
    cursor: default;
  }
  .n {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 999px;
    border: 1.5px solid var(--border-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    line-height: 1;
    color: var(--text-muted);
    transition:
      background-color var(--t-slow) var(--ease-out),
      border-color var(--t-slow) var(--ease-out),
      color var(--t-slow) var(--ease-out);
  }
  .points li.is-active .n {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }
  .points h3 {
    padding-top: 0.2rem;
    font-size: 1.15rem;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .points p {
    margin-top: 0.2rem;
    font-size: 0.97rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .review {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    max-width: 36rem;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .review :global(.icon) {
    flex: none;
    margin-top: 0.1rem;
    color: var(--primary);
  }
  .review strong {
    color: var(--ink);
    font-weight: 600;
  }

  /* Celular com a tela do anúncio (mesma escala em "em" das outras telas do app) */
  .f-stage :global(.f-phone) {
    --pw: 300px;
  }
  .ad {
    display: flex;
    flex-direction: column;
    gap: 0.55em;
    height: 100%;
    padding-bottom: 0.9em;
  }
  .ad :global(.ad-photo) {
    width: 100%;
    height: 10.4em;
    flex: none;
    object-fit: cover;
    border-radius: 1.1em;
  }
  .ad-chips {
    display: flex;
    margin-top: 0.15em;
  }
  .ad-chip {
    padding: 0.25em 0.6em;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 0.62em;
    font-weight: 600;
  }
  .ad-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.18em;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .ad-part {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6em;
    margin-inline: -0.45em;
    padding: 0.4em 0.45em;
    border-radius: 0.75em;
    box-shadow: 0 0 0 1.5px transparent;
    transition:
      box-shadow var(--t-base) var(--ease-out),
      background-color var(--t-base) var(--ease-out);
  }
  .ad-part.is-active {
    background: var(--accent-soft);
    box-shadow: 0 0 0 1.5px var(--accent);
  }
  .ad-price {
    color: var(--primary);
    font-weight: 600;
    font-size: 0.85em;
  }
  .ad-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    font-size: 0.75em;
  }
  .ad-rating :global(.icon) {
    color: var(--accent);
  }
  .ad-rating span {
    color: var(--text-muted);
  }
  .ad-pro {
    justify-content: flex-start;
    margin-inline: 0;
    padding: 0.6em 0.75em;
    border-radius: 1em;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--border);
  }
  .ad-pro .pin {
    margin-left: auto;
  }
  .ad-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.15em;
    height: 2.15em;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
    font-size: 0.75em;
  }
  .ad-pro-info {
    display: grid;
  }
  .ad-pro-name {
    font-size: 0.75em;
    font-weight: 600;
    line-height: 1.3;
  }
  .ad-ver {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    color: var(--primary);
    font-size: 0.62em;
    font-weight: 500;
  }
  .ad-desc {
    margin-top: 0.2em;
    font-size: 0.68em;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .ad-wa {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: 0.8em;
    border-radius: 999px;
    background: var(--primary);
    color: var(--text-on-dark);
    font-size: 0.8em;
    font-weight: 600;
  }
  .pin {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.35em;
    height: 1.35em;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72em;
    line-height: 1;
  }

  @media (max-width: 1023px) {
    .features-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'head'
        'stage'
        'list';
      grid-template-rows: auto;
      row-gap: 2.75rem;
    }
    .points {
      margin-top: 0;
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .f-stage :global(.f-phone) {
      --pw: 270px;
    }
  }
</style>
