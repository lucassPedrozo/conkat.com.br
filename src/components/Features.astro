---
// "O que você vê antes de chamar": um anúncio do app, em tamanho grande, com marcadores
// numerados. Cada número aponta para uma parte do anúncio e é explicado ao lado.
// Passar o mouse (ou o foco) num item acende a parte correspondente do anúncio.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { FEATURES } from '../lib/content';
import encanador from '../assets/photos/encanador.jpg';
---
<section class="features" id="anuncio" aria-labelledby="features-title" data-anatomy>
  <div class="container features-grid">
    <div class="stage" aria-hidden="true">
      <div class="listing" data-listing>
        <Image src={encanador} alt="" widths={[360, 720]} sizes="(max-width: 1023px) 90vw, 360px" class="l-photo" />
        <div class="l-body">
          <span class="l-chip">Manutenção Residencial</span>
          <p class="l-title">Encanador — reparos e instalações</p>
          <p class="l-row" data-part="1">
            <span class="l-price">A partir de R$ 120</span>
            <span class="pin" style="--d:0ms">1</span>
          </p>
          <p class="l-row" data-part="2">
            <span class="l-rating"><Icon name="star-fill" size={16} /><strong>4,8</strong><span>· 23 avaliações</span></span>
            <span class="pin" style="--d:150ms">2</span>
          </p>
          <div class="l-row l-pro" data-part="3">
            <span class="l-avatar">RC</span>
            <span class="l-pro-info">
              <span class="l-pro-name">Rafael Costa</span>
              <span class="l-ver"><Icon name="seal-check" size={14} />Verificado</span>
            </span>
            <span class="pin" style="--d:300ms">3</span>
          </div>
          <span class="l-wa"><Icon name="whatsapp-logo" size={20} />Chamar no WhatsApp</span>
        </div>
      </div>
    </div>

    <div class="copy">
      <h2 id="features-title" class="section-title">{FEATURES.title}</h2>
      <p class="lead">{FEATURES.text}</p>
      <ol class="points" role="list">
        {FEATURES.points.map((p, i) => (
          <li data-point={i + 1}>
            <span class="pin" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="review">
        <Icon name="shield-check" size={24} />
        <div>
          <h3>{FEATURES.review.title}</h3>
          <p>{FEATURES.review.text}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--section-y);
    background: var(--background);
  }
  .features-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3rem, 2rem + 4vw, 6rem);
    align-items: center;
  }
  .section-title {
    font-size: var(--step-h1);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .copy {
    display: grid;
    gap: 1.5rem;
  }
  .lead {
    max-width: 32rem;
    font-size: var(--step-lead);
    color: var(--text-muted);
  }

  /* Itens numerados */
  .points {
    display: grid;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .points li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1.1rem 1rem 1.1rem 0.75rem;
    margin-inline: -0.75rem;
    border-radius: 1rem;
    transition: background-color var(--t-base) var(--ease-out);
  }
  .points li.is-active {
    background: var(--surface);
  }
  .points h3,
  .review h3 {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    margin-bottom: 0.25rem;
  }
  .points p,
  .review p {
    color: var(--text-muted);
    font-size: 1rem;
  }
  .pin {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--ink);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9rem;
    line-height: 1;
  }
  .review {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    padding: 1.25rem 1.25rem 1.25rem 1rem;
    border-radius: var(--radius-card);
    background: var(--primary-soft);
  }
  .review :global(.icon) {
    color: var(--primary);
    justify-self: center;
    margin-top: 0.1rem;
  }

  /* Anúncio */
  .stage {
    display: grid;
    place-items: center;
    padding: clamp(1.5rem, 1rem + 3vw, 3.5rem);
    border-radius: var(--radius-media);
    background: var(--ink);
    background-image: radial-gradient(120% 80% at 50% 0%, var(--ink-soft), var(--ink));
  }
  .listing {
    width: min(100%, 22.5rem);
    border-radius: 1.5rem;
    background: var(--surface);
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.6);
    overflow: hidden;
  }
  .listing :global(.l-photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .l-body {
    display: grid;
    gap: 0.35rem;
    padding: 1.1rem 1.1rem 1.25rem;
  }
  .l-chip {
    justify-self: start;
    padding: 0.25rem 0.65rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .l-title {
    margin-top: 0.35rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.35rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .l-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-inline: -0.5rem;
    padding: 0.4rem 0.5rem;
    border-radius: 0.75rem;
    box-shadow: 0 0 0 2px transparent;
    transition:
      box-shadow var(--t-base) var(--ease-out),
      background-color var(--t-base) var(--ease-out);
  }
  .l-row.is-active {
    background: var(--accent-soft);
    box-shadow: 0 0 0 2px var(--accent);
  }
  .l-price {
    color: var(--primary);
    font-weight: 600;
    font-size: 1.05rem;
  }
  .l-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.95rem;
  }
  .l-rating :global(.icon) {
    color: var(--accent);
  }
  .l-rating span {
    color: var(--text-muted);
  }
  .l-pro {
    justify-content: flex-start;
    margin-top: 0.35rem;
  }
  .l-pro .pin {
    margin-left: auto;
  }
  .l-avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--primary-soft);
    color: var(--primary);
    font-weight: 600;
    font-size: 0.85rem;
  }
  .l-pro-info {
    display: grid;
  }
  .l-pro-name {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .l-ver {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--primary);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .l-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
    padding: 0.85rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--text-on-dark);
    font-weight: 600;
  }

  /* Os marcadores do anúncio aparecem um a um quando a seção entra na tela */
  .listing .pin {
    transform: scale(0.4);
    opacity: 0;
    transition:
      transform 450ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 200ms var(--ease-out);
  }
  .listing .pin {
    transition-delay: var(--d, 0ms);
  }
  .is-on .listing .pin {
    transform: none;
    opacity: 1;
  }

  @media (max-width: 1023px) {
    .features-grid {
      grid-template-columns: 1fr;
    }
    /* No celular: título e texto, depois o anúncio, depois os itens */
    .copy {
      display: contents;
    }
    .section-title { order: 0; }
    .lead { order: 1; margin-top: -1rem; }
    .stage { order: 2; }
    .points { order: 3; margin-top: 0; }
    .review { order: 4; margin-top: -1rem; }
    .features-grid {
      gap: 2.5rem;
    }
  }
</style>
