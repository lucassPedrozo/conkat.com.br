---
// "Para profissionais": a oferta em dois números, a foto com o card de desempenho e,
// abaixo, o caminho do cadastro até o anúncio no ar em quatro passos.
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { PRO, APP_LIVE } from '../lib/content';
import eletricista from '../assets/photos/eletricista.jpg';
---
<section class="pros on-dark" id="profissionais" aria-labelledby="pros-title">
  <div class="container">
    <div class="pros-top">
      <div class="pros-copy">
        <p class="kicker">{PRO.kicker}</p>
        <h2 id="pros-title" class="pros-title">{PRO.title}</h2>
        <p class="pros-text">{PRO.text}</p>
        <dl class="offer">
          {PRO.offer.map((o) => (
            <div>
              <dt>{o.value}</dt>
              <dd>{o.text}</dd>
            </div>
          ))}
        </dl>
        {APP_LIVE ? <a class="btn btn-accent" href="#">{PRO.cta}</a> : <p class="pros-soon"><Icon name="clock" size={18} />{PRO.soon}</p>}
      </div>
      <div class="pros-media" data-chart>
        <Image src={eletricista} alt="Eletricista instalando uma tomada em um apartamento" widths={[480, 720, 1024]} sizes="(max-width: 1023px) 100vw, 520px" class="pros-photo" />
        <div class="metrics" aria-hidden="true">
          <p class="m-label">Últimos 7 dias</p>
          <div class="m-nums">
            <p><strong>1.284</strong><span>exibições em buscas</span></p>
            <p><strong>312</strong><span>visualizações</span></p>
          </div>
          <svg class="m-chart" viewBox="0 0 260 56" preserveAspectRatio="none">
            <path d="M0 55.5H260" stroke="#E5E7EB" fill="none" />
            <path class="line line-a" pathLength="1" d="M0 42 L37 36 L74 39 L111 27 L148 29 L185 17 L222 13 L260 5" />
            <path class="line line-b" pathLength="1" d="M0 49 L37 47 L74 48 L111 43 L148 44 L185 40 L222 38 L260 35" />
          </svg>
        </div>
      </div>
    </div>

    <div class="journey">
      <h3 class="journey-title">{PRO.stepsTitle}</h3>
      <ol class="steps" role="list">
        {PRO.steps.map((s, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .pros {
    padding-block: var(--section-y);
    background: var(--ink);
    color: var(--text-on-dark);
  }
  .pros-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    align-items: center;
  }
  .pros-copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .kicker {
    color: var(--accent);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.01em;
  }
  .pros-title {
    margin-top: -0.75rem;
    font-size: var(--step-h1);
    line-height: 1.1;
    letter-spacing: -0.03em;
    max-width: 15em;
  }
  .pros-text {
    max-width: 32rem;
    font-size: var(--step-lead);
    color: var(--text-on-dark-muted);
  }

  /* Oferta */
  .offer {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 34rem;
    margin: 0.5rem 0 0;
  }
  .offer div {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.25rem 1.25rem 1.35rem;
    border-radius: var(--radius-card);
    background: var(--ink-soft);
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .offer dt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 1.6rem + 1.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--accent);
  }
  .offer dd {
    margin: 0;
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .pros-soon {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--text-on-dark-muted);
    font-size: 0.95rem;
  }
  .pros-soon :global(.icon) {
    flex: none;
    color: var(--accent);
  }

  /* Foto e desempenho */
  .pros-media {
    position: relative;
  }
  .pros-media :global(.pros-photo) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-media);
  }
  .metrics {
    position: absolute;
    left: 1.5rem;
    bottom: 1.5rem;
    width: min(19rem, calc(100% - 3rem));
    padding: 1.1rem 1.15rem;
    border-radius: 1rem;
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 24px 48px -20px rgba(0, 0, 0, 0.5);
  }
  .m-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    font-weight: 500;
  }
  .m-nums {
    display: flex;
    gap: 1.5rem;
    margin: 0.5rem 0 0.75rem;
  }
  .m-nums p {
    display: grid;
  }
  .m-nums strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.65rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .m-nums span {
    font-size: 0.72rem;
    color: var(--text-muted);
  }
  .m-chart {
    width: 100%;
    height: 3.25rem;
    overflow: visible;
  }
  .line {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1400ms var(--ease-in-out);
  }
  .line-a {
    stroke: var(--primary);
  }
  .line-b {
    stroke: var(--accent);
    stroke-width: 2;
    transition-delay: 200ms;
  }
  .pros-media.is-on .line {
    stroke-dashoffset: 0;
  }

  /* Do cadastro ao anúncio no ar */
  .journey {
    margin-top: clamp(4rem, 3rem + 4vw, 6.5rem);
  }
  .journey-title {
    font-size: var(--step-h3);
    letter-spacing: -0.015em;
    margin-bottom: 2rem;
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* Linha que liga os números */
  .steps::before {
    content: '';
    position: absolute;
    top: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
  }
  .steps li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.5rem;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--ink);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: var(--text-on-dark);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .steps li:last-child .step-n {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--ink);
  }
  .steps h4 {
    font-size: 1.125rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .steps p {
    color: var(--text-on-dark-muted);
    font-size: 1rem;
  }

  @media (max-width: 1023px) {
    .pros-top {
      grid-template-columns: 1fr;
    }
    .pros-media {
      order: -1;
    }
    .pros-media :global(.pros-photo) {
      aspect-ratio: 1 / 1;
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
    .steps::before {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .offer {
      grid-template-columns: 1fr;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .steps li {
      grid-template-columns: 2.5rem 1fr;
      column-gap: 1rem;
      padding-bottom: 1.75rem;
    }
    .steps li > :not(.step-n) {
      grid-column: 2;
    }
    .step-n {
      grid-row: 1 / span 2;
      margin-bottom: 0;
    }
    /* No celular, a linha desce entre os números */
    .steps li:not(:last-child)::before {
      content: '';
      position: absolute;
      top: 2.5rem;
      bottom: 0;
      left: 1.25rem;
      width: 1px;
      background: rgba(255, 255, 255, 0.14);
    }
  }
</style>
