---
// "Para profissionais": a proposta, as condições lidas como uma tabela (sem números
// decorativos) e a tela real de Desempenho do app no lugar de foto. Abaixo, o caminho do
// cadastro até o anúncio no ar, em quatro passos.
import Icon from './Icon.astro';
import Phone from './app/Phone.astro';
import PerformanceScreen from './app/PerformanceScreen.astro';
import { PRO, APP_LIVE } from '../lib/content';
---
<section class="pros" id="profissionais" aria-labelledby="pros-title">
  <div class="container">
    <div class="pros-top">
      <div class="pros-copy">
        <p class="kicker">{PRO.kicker}</p>
        <h2 id="pros-title" class="pros-title">{PRO.title}</h2>
        <p class="pros-text">{PRO.text}</p>

        <dl class="terms">
          {PRO.terms.map((t) => (
            <div class="term">
              <dt>{t.label}</dt>
              <dd><strong>{t.value}</strong><span>{t.text}</span></dd>
            </div>
          ))}
        </dl>

        {APP_LIVE
          ? <a class="btn btn-primary" href="#">{PRO.cta}</a>
          : <p class="pros-soon"><Icon name="clock" size={18} />{PRO.soon}</p>}
      </div>

      <figure class="pros-media" data-chart>
        <Phone class="pros-phone" label="Tela de desempenho do anúncio no app Conkat"><PerformanceScreen /></Phone>
        <figcaption>{PRO.caption}</figcaption>
      </figure>
    </div>

    <div class="journey">
      <h3 class="journey-title">{PRO.stepsTitle}</h3>
      <ol class="steps" role="list">
        {PRO.steps.map((s, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .pros {
    padding-block: var(--section-y);
    background: var(--primary-soft);
    color: var(--ink);
  }
  .pros-top {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(3rem, 2rem + 5vw, 7rem);
    align-items: center;
  }
  .pros-copy {
    display: grid;
    justify-items: start;
  }
  .kicker {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--primary);
  }
  .pros-title {
    margin-top: 1rem;
    font-size: var(--step-h1);
    line-height: 1.08;
    letter-spacing: -0.03em;
    max-width: 14em;
  }
  .pros-text {
    margin-top: 1.25rem;
    max-width: 32rem;
    font-size: var(--step-lead);
    line-height: 1.55;
    color: var(--text-muted);
  }

  /* Condições: tabela com linhas, sem cards */
  .terms {
    width: 100%;
    max-width: 36rem;
    margin: 2.25rem 0 0;
    border-top: 1px solid rgba(11, 43, 42, 0.14);
  }
  .term {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.05rem 0;
    border-bottom: 1px solid rgba(11, 43, 42, 0.14);
  }
  .term dt {
    padding-top: 0.2rem;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .term dd {
    display: grid;
    gap: 0.15rem;
    margin: 0;
  }
  .term strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.015em;
    color: var(--ink);
  }
  .term span {
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .pros-soon {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.75rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .pros-soon :global(.icon) {
    flex: none;
    color: var(--primary);
  }
  .pros-copy .btn {
    margin-top: 1.75rem;
  }

  /* Tela real do app */
  .pros-media {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    margin: 0;
  }
  .pros-media :global(.pros-phone) {
    --pw: 300px;
  }
  figcaption {
    max-width: 19rem;
    text-align: center;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  /* Do cadastro ao anúncio no ar */
  .journey {
    margin-top: clamp(4.5rem, 3rem + 5vw, 7rem);
  }
  .journey-title {
    font-size: var(--step-h3);
    letter-spacing: -0.015em;
    margin-bottom: 1.75rem;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .steps li {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(11, 43, 42, 0.18);
  }
  .step-n {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--primary);
    margin-bottom: 0.5rem;
  }
  .steps h4 {
    font-size: 1.1rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .steps p {
    color: var(--text-muted);
    font-size: 0.97rem;
    line-height: 1.5;
  }

  @media (max-width: 1023px) {
    .pros-top {
      grid-template-columns: 1fr;
    }
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.25rem;
    }
  }
  @media (max-width: 560px) {
    .term {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
    .term dt {
      padding-top: 0;
      font-size: 0.82rem;
    }
    .pros-media :global(.pros-phone) {
      --pw: 270px;
    }
    .steps {
      grid-template-columns: 1fr;
      row-gap: 1.75rem;
    }
  }
</style>
