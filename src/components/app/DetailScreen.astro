---
// Tela do anúncio: galeria, selos, título, preço, profissional verificado e botão de WhatsApp.
import { Image } from 'astro:assets';
import Icon from '../Icon.astro';
import cozinha from '../../assets/photos/cozinha.jpg';
import marina from '../../assets/photos/marina.jpg';
const { eager = false } = Astro.props as { eager?: boolean };
const loading = eager ? 'eager' : 'lazy';
---
<div class="detail">
  <Image src={cozinha} alt="" widths={[300, 540]} sizes="270px" class="gallery" loading={loading} />
  <div class="chips"><span class="chip chip-accent">Destaque</span><span class="chip">Limpeza e Conservação</span></div>
  <p class="d-title">Diarista — limpeza completa</p>
  <p class="d-price">R$ 180 por dia</p>
  <div class="pro">
    <Image src={marina} alt="" width={80} height={80} class="avatar" loading={loading} />
    <div class="pro-info">
      <p class="pro-name">Marina Souza</p>
      <p class="pro-ver"><Icon name="seal-check" size={11} />Verificado</p>
    </div>
    <span class="pro-rating"><Icon name="star-fill" size={12} />4,9</span>
  </div>
  <p class="d-desc">Limpeza completa de casas e apartamentos, com produtos inclusos. Atendo toda a zona norte.</p>
  <span class="wa" data-wa><Icon name="whatsapp-logo" size={18} />Chamar no WhatsApp</span>
</div>

<style>
  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.7em;
    height: 100%;
    padding-bottom: 0.9em;
  }
  .detail :global(.gallery) {
    width: 100%;
    height: 10.4em;
    flex: none;
    object-fit: cover;
    border-radius: 1.1em;
  }
  .chips {
    display: flex;
    gap: 0.4em;
  }
  .chip {
    padding: 0.25em 0.6em;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-size: 0.62em;
    font-weight: 600;
  }
  .chip-accent {
    background: var(--accent);
    border-color: var(--accent);
  }
  .d-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.18em;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .d-price {
    margin-top: -0.4em;
    color: var(--primary);
    font-weight: 600;
    font-size: 0.75em;
  }
  .pro {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.6em 0.75em;
    border-radius: 1em;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .detail :global(.avatar) {
    width: 2.15em;
    height: 2.15em;
    border-radius: 50%;
    object-fit: cover;
  }
  .pro-info {
    flex: 1;
  }
  .pro-name {
    font-size: 0.75em;
    font-weight: 600;
    line-height: 1.3;
  }
  .pro-ver {
    display: flex;
    align-items: center;
    gap: 0.25em;
    color: var(--primary);
    font-size: 0.62em;
    font-weight: 500;
  }
  .pro-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-size: 0.75em;
    font-weight: 600;
  }
  .pro-rating :global(.icon) {
    color: var(--accent);
  }
  .d-desc {
    font-size: 0.68em;
    line-height: 1.5;
    color: var(--text-muted);
  }
  .wa {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    padding: 0.8em;
    border-radius: 999px;
    background: var(--primary);
    color: var(--text-on-dark);
    font-size: 0.8em;
    font-weight: 600;
  }
</style>
