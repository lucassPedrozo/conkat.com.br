---
// Card compacto de anúncio, como nas listas do app (foto quadrada, título, categoria, preço, nota).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
interface Props { title: string; category: string; price: string; rating: string; photo: ImageMetadata; class?: string; style?: string; eager?: boolean }
const { title, category, price, rating, photo, class: className = '', style, eager = false } = Astro.props;
---
<div class={`lc ${className}`} style={style}>
  <Image src={photo} alt="" width={128} height={128} class="lc-photo" loading={eager ? "eager" : "lazy"} />
  <div class="lc-info">
    <p class="lc-title">{title}</p>
    <p class="lc-cat">{category}</p>
    <p class="lc-row"><span class="lc-price">{price}</span><span class="lc-rating"><Icon name="star-fill" size={11} />{rating}</span></p>
  </div>
</div>

<style>
  .lc {
    display: flex;
    gap: 0.65em;
    align-items: center;
    padding: 0.5em;
    border-radius: 0.9em;
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .lc-photo {
    flex: none;
    width: 3.9em;
    height: 3.9em;
    border-radius: 0.65em;
    object-fit: cover;
  }
  .lc-info {
    min-width: 0;
    display: grid;
    gap: 0.12em;
  }
  .lc-title {
    font-size: 0.78em;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .lc-cat {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 0.64em;
    color: var(--text-muted);
    line-height: 1.3;
  }
  .lc-row {
    white-space: nowrap;
    display: flex;
    gap: 0.6em;
    align-items: center;
    font-size: 0.7em;
    line-height: 1.3;
  }
  .lc-price {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--primary);
    font-weight: 600;
  }
  .lc-rating {
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    font-weight: 600;
  }
  .lc-rating :global(.icon) {
    flex: none;
    color: var(--accent);
    width: 1em;
    height: 1em;
  }
</style>
