---
// "Como funciona": no desktop, o celular fica parado enquanto os três passos passam ao lado;
// a tela muda junto com o passo (o momento de destaque do site). No celular, cada passo
// mostra a sua tela logo abaixo do texto.
import Phone from './app/Phone.astro';
import HomeScreen from './app/HomeScreen.astro';
import CityScreen from './app/CityScreen.astro';
import SearchScreen from './app/SearchScreen.astro';
import DetailScreen from './app/DetailScreen.astro';
import { STEPS } from '../lib/content';
---
<section class="how" id="como-funciona" aria-labelledby="how-title" data-how>
  <div class="container">
    <h2 id="how-title" class="section-title">Como funciona</h2>
    <div class="how-grid">
      <ol class="steps">
        {STEPS.map((s, i) => (
          <li class="step" data-step={i}>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <div class="step-body">
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
            <div class="step-phone" aria-hidden="true">
              <Phone class="mini-phone" label="">
                <div class="screen is-active">
                  {i === 0 && <><HomeScreen /><CityScreen /></>}
                  {i === 1 && <SearchScreen />}
                  {i === 2 && <DetailScreen />}
                </div>
              </Phone>
            </div>
          </li>
        ))}
      </ol>
      <div class="how-stage" aria-hidden="true">
        <div class="how-sticky">
          <Phone class="how-phone" label="Telas do app Conkat">
            <div class="screen is-active" data-screen="0"><HomeScreen /><CityScreen /></div>
            <div class="screen" data-screen="1"><SearchScreen /></div>
            <div class="screen" data-screen="2"><DetailScreen /></div>
          </Phone>
          <div class="progress" aria-hidden="true">
            {STEPS.map((_, i) => <span class={i === 0 ? 'is-active' : ''} data-dot={i}></span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .how {
    padding-block: var(--section-y);
    background: var(--surface);
  }
  .section-title {
    font-size: var(--step-h1);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .how-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4rem;
  }
  .steps {
    margin: 0;
    padding: 0 0 14vh;
    list-style: none;
  }
  .step {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 1.25rem;
    min-height: 78vh;
    align-content: center;
    opacity: 0.32;
    transition: opacity 500ms var(--ease-out);
  }
  .step.is-active {
    opacity: 1;
  }
  .step-n {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    border: 1.5px solid var(--border-strong);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--text-muted);
    transition:
      background-color var(--t-slow) var(--ease-out),
      border-color var(--t-slow) var(--ease-out),
      color var(--t-slow) var(--ease-out);
  }
  .step.is-active .step-n {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--text-on-dark);
  }
  .step-body {
    display: grid;
    gap: 0.75rem;
    max-width: 28rem;
  }
  .step h3 {
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.1rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--ink);
  }
  .step p {
    font-size: var(--step-lead);
    color: var(--text-muted);
  }
  .how-stage {
    position: relative;
  }
  .how-sticky {
    position: sticky;
    top: calc(50vh - 19rem);
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding-block: 2rem;
  }
  .how-stage :global(.how-phone) {
    --pw: 300px;
  }
  .screen {
    position: absolute;
    inset: 0;
    padding: 0.55em 0.8em 0;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 450ms var(--ease-out),
      transform 450ms var(--ease-out);
    pointer-events: none;
  }
  .screen.is-active {
    opacity: 1;
    transform: none;
  }
  /* A folha de cidade sobe quando o passo 1 está ativo */
  .screen :global(.sheet) {
    transform: translateY(100%);
    transition: transform 550ms var(--ease-out) 150ms;
  }
  .screen.is-active :global(.sheet) {
    transform: none;
  }
  .screen :global(.scrim) {
    opacity: 0;
    transition: opacity 400ms var(--ease-out) 100ms;
  }
  .screen.is-active :global(.scrim) {
    opacity: 1;
  }
  .screen :global(.stagger) {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 300ms var(--ease-out),
      transform 300ms var(--ease-out);
    transition-delay: calc(250ms + var(--i) * 40ms);
  }
  .screen.is-active :global(.stagger) {
    opacity: 1;
    transform: none;
  }
  /* No passo 3, o botão do WhatsApp chama atenção uma vez */
  .screen.is-active :global([data-wa]) {
    animation: wa-pulse 1.4s var(--ease-out) 600ms 1;
  }
  @keyframes wa-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(11, 122, 117, 0.45);
    }
    100% {
      box-shadow: 0 0 0 14px rgba(11, 122, 117, 0);
    }
  }
  .progress {
    display: flex;
    gap: 6px;
  }
  .progress span {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: var(--border-strong);
    transition:
      width var(--t-slow) var(--ease-out),
      background-color var(--t-slow) var(--ease-out);
  }
  .progress span.is-active {
    width: 24px;
    background: var(--ink);
  }

  .step-phone {
    display: none;
  }

  /* Telas menores: passo + tela, um embaixo do outro */
  @media (max-width: 1023px) {
    .how-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .how-stage {
      display: none;
    }
    .steps {
      padding-bottom: 0;
    }
    .step {
      min-height: 0;
      opacity: 1;
      padding-block: 2.5rem;
      border-top: 1px solid var(--border);
    }
    .step:first-child {
      margin-top: 2rem;
    }
    .step .step-n {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--text-on-dark);
    }
    .step-phone {
      display: block;
      grid-column: 1 / -1;
      height: 25rem;
      margin-top: 0.75rem;
      overflow: hidden;
      border-radius: var(--radius-media);
      background: var(--primary-soft);
      padding-top: 2rem;
      -webkit-mask-image: linear-gradient(#000 80%, transparent);
      mask-image: linear-gradient(#000 80%, transparent);
    }
    .step-phone :global(.mini-phone) {
      --pw: 260px;
      margin-inline: auto;
    }
  }
</style>
