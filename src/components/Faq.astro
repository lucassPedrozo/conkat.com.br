---
import { FAQ, FAQ_TITLE } from '../lib/content';
---
<section class="faq" id="duvidas" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <h2 id="faq-title" class="section-title">{FAQ_TITLE}</h2>
    <div class="faq-list">
      {FAQ.map(([q, a], i) => (
        <details class="qa" open={i === 0} name="faq">
          <summary>
            <span>{q}</span>
            <span class="pm" aria-hidden="true"></span>
          </summary>
          <div class="answer"><div><p>{a}</p></div></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-y);
    background: var(--surface);
  }
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 3rem;
    align-items: start;
  }
  .section-title {
    font-size: var(--step-h1);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--ink);
    max-width: 8em;
  }
  .faq-list {
    border-top: 1px solid var(--border);
  }
  .qa {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.6rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
    color: var(--ink);
    border-radius: 6px;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .pm {
    position: relative;
    flex: none;
    width: 1.25rem;
    height: 1.25rem;
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 0;
    top: calc(50% - 1px);
    width: 100%;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--t-slow) var(--ease-out);
  }
  .pm::after {
    transform: rotate(90deg);
  }
  .qa[open] .pm::after {
    transform: rotate(0deg);
  }
  .answer {
    display: grid;
    grid-template-rows: 1fr;
  }
  .answer > div {
    overflow: hidden;
  }
  .answer p {
    max-width: 40rem;
    padding-bottom: 1.6rem;
    color: var(--text-muted);
  }
  /* Abertura suave onde o navegador permite animar o conteúdo do details */
  @supports (interpolate-size: allow-keywords) {
    .faq-list {
      interpolate-size: allow-keywords;
    }
    .qa::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 350ms var(--ease-out),
        content-visibility 350ms allow-discrete;
    }
    .qa[open]::details-content {
      height: auto;
    }
  }
  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    summary {
      font-size: 1.08rem;
    }
  }
</style>
